rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all safety net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL HELPERS
    // ==========================================

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user email is verified
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Multi-tenancy Isolation: Document companyId matches user's companyId custom claim
    function hasValidTenantId(data) {
      return isSignedIn() && 
             request.auth.token.companyId != null && 
             data.companyId == request.auth.token.companyId;
    }

    // Admin role validation (within their tenant)
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.role == 'admin';
    }

    // Technician role validation
    function isTechnician() {
      return isSignedIn() && 
             request.auth.token.role == 'technician';
    }

    // Helper to check standard ID formats to guard against ID Poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Multi-tenancy check: document companyId matches user companyId
    function belongsToTenant(resourceData) {
      return isSignedIn() && 
             request.auth.token.companyId != null && 
             resourceData.companyId == request.auth.token.companyId;
    }

    // Check if a work order is assigned to the current technician
    function isAssignedToMe(orderData) {
      return isTechnician() && (
        orderData.techId == request.auth.uid || 
        orderData.tech == request.auth.uid ||
        orderData.assignedTo == request.auth.uid
      );
    }

    // Get companyId custom claim from auth token
    function getCompanyId() {
      return request.auth.token.companyId;
    }

    // ==========================================
    // ENTITY VALIDATION BLUEPRINTS
    // ==========================================

    function isValidVehicle(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('plate' in data) || data.plate == null || (data.plate is string && data.plate.size() <= 50)) &&
             (!('plateNumber' in data) || data.plateNumber == null || (data.plateNumber is string && data.plateNumber.size() <= 50)) &&
             data.name is string && data.name.size() <= 100 &&
             hasValidTenantId(data);
    }

    function isValidMaintenanceOrderFields(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             (!('type' in data) || data.type == null || (data.type is string && data.type.size() <= 100)) &&
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidMaintenanceOrder(data) {
      return isValidMaintenanceOrderFields(data) &&
             hasValidTenantId(data);
    }

    function isValidFaultReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() <= 50 &&
             data.category is string && data.category.size() <= 100 &&
             data.vehicle is string && data.vehicle.size() <= 150 &&
             data.priority is string && data.priority.size() <= 50 &&
             data.status is string && data.status.size() <= 50 &&
             data.desc is string && data.desc.size() <= 1000 &&
             (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 1000000)) &&
             (!('obdCode' in data) || data.obdCode == null || (data.obdCode is string && data.obdCode.size() <= 50)) &&
             (!('symptom' in data) || data.symptom == null || (data.symptom is string && data.symptom.size() <= 200)) &&
             (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 128)) &&
             isValidId(data.id);
    }

    function isValidTechnician(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.specialty is string && data.specialty.size() <= 100 &&
             hasValidTenantId(data);
    }

    function isValidInventoryItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             (!('quantity' in data) || data.quantity == null || data.quantity is number) &&
             (!('qty' in data) || data.qty == null || data.qty is number) &&
             (!('price' in data) || data.price == null || data.price is number) &&
             hasValidTenantId(data);
    }

    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.category is string &&
             data.priority is string &&
             data.description is string &&
             data.status is string &&
             hasValidTenantId(data);
    }

    function isValidCustomDevRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string &&
             data.impact is string &&
             data.timeframe is string &&
             data.status is string &&
             hasValidTenantId(data);
    }

    function isValidTechnicalInspection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderId is string && data.orderId.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             data.checkedBy is string &&
             hasValidTenantId(data);
    }

    function isValidSafetyInspection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             hasValidTenantId(data);
    }

    function isValidSaaSLead(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidRegisteredCompany(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidCompanySubscription(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.companyId is string && data.companyId.size() <= 128 &&
             hasValidTenantId(data);
    }

    function isValidBillingRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             hasValidTenantId(data);
    }

    // ==========================================
    // SECURED PATHS (TENANT ISOLATION & RBAC)
    // ==========================================

    // 1. VEHICLES
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() && isValidVehicle(request.resource.data)) ||
                    (request.auth == null && isValidVehicle(request.resource.data));
      allow update: if (isAdmin() && isValidVehicle(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (request.auth == null && isValidVehicle(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 2. MAINTENANCE / WORK ORDERS
    match /maintenance_orders/{orderId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() && isValidMaintenanceOrder(request.resource.data)) ||
                    (request.auth == null && isValidMaintenanceOrderFields(request.resource.data));
      allow update: if (isAdmin() && isValidMaintenanceOrder(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (isAssignedToMe(resource.data) && isValidMaintenanceOrderFields(request.resource.data) && request.resource.data.id == resource.data.id && request.resource.data.vehicleId == resource.data.vehicleId) ||
                    (request.auth == null && isValidMaintenanceOrderFields(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // Support alias match for 'work_orders' if used in client side
    match /work_orders/{orderId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() && isValidMaintenanceOrder(request.resource.data)) ||
                    (request.auth == null && isValidMaintenanceOrderFields(request.resource.data));
      allow update: if (isAdmin() && isValidMaintenanceOrder(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (isAssignedToMe(resource.data) && isValidMaintenanceOrderFields(request.resource.data) && request.resource.data.id == resource.data.id && request.resource.data.vehicleId == resource.data.vehicleId) ||
                    (request.auth == null && isValidMaintenanceOrderFields(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 3. TECHNICIANS
    match /technicians/{techId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() && isValidTechnician(request.resource.data)) ||
                    (request.auth == null && isValidTechnician(request.resource.data));
      allow update: if (isAdmin() && isValidTechnician(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (request.auth == null && isValidTechnician(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 4. INVENTORY
    match /inventory/{itemId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() && isValidInventoryItem(request.resource.data)) ||
                    (request.auth == null && isValidInventoryItem(request.resource.data));
      allow update: if ((isAdmin() || isTechnician()) && isValidInventoryItem(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (request.auth == null && isValidInventoryItem(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 5. SUPPORT TICKETS
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() || isTechnician()) && isValidSupportTicket(request.resource.data);
      allow update: if (isAdmin() || isTechnician()) && isValidSupportTicket(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 6. CUSTOM DEVELOPMENT REQUESTS
    match /custom_dev_requests/{requestId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if isAdmin() && isValidCustomDevRequest(request.resource.data);
      allow update: if isAdmin() && isValidCustomDevRequest(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 7. TECHNICAL INSPECTIONS
    match /technical_inspections/{inspectionId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if (isAdmin() || isTechnician()) && isValidTechnicalInspection(request.resource.data);
      allow update: if (isAdmin() || isTechnician()) && isValidTechnicalInspection(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 8. SAFETY INSPECTIONS
    match /safety_inspections/{inspectionId} {
      allow get: if isSignedIn() && belongsToTenant(resource.data);
      allow list: if isSignedIn() && resource.data.companyId == getCompanyId();
      allow create: if ((isAdmin() || isTechnician()) && isValidSafetyInspection(request.resource.data)) ||
                    (request.auth == null && isValidSafetyInspection(request.resource.data));
      allow update: if ((isAdmin() || isTechnician()) && isValidSafetyInspection(request.resource.data) && request.resource.data.companyId == resource.data.companyId) ||
                    (request.auth == null && isValidSafetyInspection(request.resource.data));
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 9. SENSITIVE COLLECTIONS: BILLING AND SUBSCRIPTIONS
    // Match billing
    match /billing/{billingId} {
      allow get: if isAdmin() && belongsToTenant(resource.data);
      allow list: if isAdmin() && resource.data.companyId == getCompanyId();
      allow create: if isAdmin() && isValidBillingRecord(request.resource.data);
      allow update: if isAdmin() && isValidBillingRecord(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }
    // Match subscriptions
    match /subscriptions/{subId} {
      allow get: if isAdmin() && belongsToTenant(resource.data);
      allow list: if isAdmin() && resource.data.companyId == getCompanyId();
      allow create: if isAdmin() && isValidCompanySubscription(request.resource.data);
      allow update: if isAdmin() && isValidCompanySubscription(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }
    // Match company_subscriptions (from blueprint)
    match /company_subscriptions/{subId} {
      allow get: if isAdmin() && belongsToTenant(resource.data);
      allow list: if isAdmin() && resource.data.companyId == getCompanyId();
      allow create: if isAdmin() && isValidCompanySubscription(request.resource.data);
      allow update: if isAdmin() && isValidCompanySubscription(request.resource.data) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isAdmin() && belongsToTenant(resource.data);
    }

    // 10. PUBLIC/MARKETING DATA (SaaS Leads, Settings, Features, Clients, Reviews, Registered Companies)
    match /saas_leads/{leadId} {
      allow create: if true; // Public prospects can submit leads
      allow read, update, delete: if isAdmin(); // Only system/tenant admins can manage leads
    }

    match /saas_settings/{settingId} {
      allow read: if true; // Public branding settings
      allow write: if isAdmin();
    }

    match /saas_features/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saas_clients/{clientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saas_reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registered_companies/{companyId} {
      allow read: if isSignedIn(); // Any authenticated user can check company rosters
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 11. FAULT REPORTS
    match /fault_reports/{reportId} {
      allow read, update, delete: if isSignedIn();
      allow create: if isValidFaultReport(request.resource.data);
    }
  }
}
