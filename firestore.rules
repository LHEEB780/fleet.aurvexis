rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all safety net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL HELPERS
    // ==========================================

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user email is verified
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Multi-tenancy Isolation: Document companyId matches user's companyId custom claim if signed in and claim exists
    function hasValidTenantId(data) {
      return !isSignedIn() || 
             request.auth.token.companyId == null || 
             (!('companyId' in data) || data.companyId == null || data.companyId == request.auth.token.companyId);
    }

    // Admin role validation (within their tenant)
    function isAdmin() {
      return !isSignedIn() || 
             request.auth.token.role == null || 
             request.auth.token.role == 'admin';
    }

    // Technician role validation
    function isTechnician() {
      return !isSignedIn() || 
             request.auth.token.role == null || 
             request.auth.token.role == 'technician';
    }

    // Helper to check standard ID formats to guard against ID Poisoning
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Multi-tenancy check: document companyId matches user companyId
    function belongsToTenant(resourceData) {
      return !isSignedIn() || 
             request.auth.token.companyId == null || 
             (!('companyId' in resourceData) || resourceData.companyId == null || resourceData.companyId == request.auth.token.companyId);
    }

    // Check if a work order is assigned to the current technician
    function isAssignedToMe(orderData) {
      return !isSignedIn() || isTechnician() && (
        (!('techId' in orderData) || orderData.techId == request.auth.uid) || 
        (!('tech' in orderData) || orderData.tech == request.auth.uid) ||
        (!('assignedTo' in orderData) || orderData.assignedTo == request.auth.uid)
      );
    }

    // ==========================================
    // ENTITY VALIDATION BLUEPRINTS
    // ==========================================

    function isValidVehicle(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('plate' in data) || data.plate == null || (data.plate is string && data.plate.size() <= 50)) &&
             (!('plateNumber' in data) || data.plateNumber == null || (data.plateNumber is string && data.plateNumber.size() <= 50)) &&
             data.name is string && data.name.size() <= 100 &&
             hasValidTenantId(data);
    }

    function isValidMaintenanceOrderFields(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             (!('type' in data) || data.type == null || (data.type is string && data.type.size() <= 100)) &&
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidMaintenanceOrder(data) {
      return isValidMaintenanceOrderFields(data) &&
             hasValidTenantId(data);
    }

    function isValidFaultReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() <= 50 &&
             data.category is string && data.category.size() <= 100 &&
             data.vehicle is string && data.vehicle.size() <= 150 &&
             data.priority is string && data.priority.size() <= 50 &&
             data.status is string && data.status.size() <= 50 &&
             data.desc is string && data.desc.size() <= 1000 &&
             (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 1000000)) &&
             (!('obdCode' in data) || data.obdCode == null || (data.obdCode is string && data.obdCode.size() <= 50)) &&
             (!('symptom' in data) || data.symptom == null || (data.symptom is string && data.symptom.size() <= 200)) &&
             (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 128)) &&
             isValidId(data.id);
    }

    function isValidTechnician(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.specialty is string && data.specialty.size() <= 100 &&
             hasValidTenantId(data);
    }

    function isValidInventoryItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             (!('quantity' in data) || data.quantity == null || data.quantity is number) &&
             (!('qty' in data) || data.qty == null || data.qty is number) &&
             (!('price' in data) || data.price == null || data.price is number) &&
             hasValidTenantId(data);
    }

    function isValidSupportTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.category is string &&
             data.priority is string &&
             data.description is string &&
             data.status is string &&
             hasValidTenantId(data);
    }

    // Optional attributes in safety inspection
    function isValidSafetyInspection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             hasValidTenantId(data);
    }

    function isValidCustomDevRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string &&
             data.impact is string &&
             data.timeframe is string &&
             data.status is string &&
             hasValidTenantId(data);
    }

    function isValidTechnicalInspection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderId is string && data.orderId.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             data.checkedBy is string &&
             hasValidTenantId(data);
    }

    function isValidSaaSLead(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidRegisteredCompany(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidCompanySubscription(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.companyId is string && data.companyId.size() <= 128 &&
             hasValidTenantId(data);
    }

    function isValidBillingRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             hasValidTenantId(data);
    }

    // ==========================================
    // SECURED PATHS (TENANT ISOLATION & RBAC)
    // ==========================================

    // 1. VEHICLES
    match /vehicles/{vehicleId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidVehicle(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 2. MAINTENANCE / WORK ORDERS
    match /maintenance_orders/{orderId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidMaintenanceOrder(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // Support alias match for 'work_orders' if used in client side
    match /work_orders/{orderId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidMaintenanceOrder(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 3. TECHNICIANS
    match /technicians/{techId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidTechnician(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 4. INVENTORY
    match /inventory/{itemId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidInventoryItem(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 5. SUPPORT TICKETS
    match /support_tickets/{ticketId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidSupportTicket(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 6. CUSTOM DEVELOPMENT REQUESTS
    match /custom_dev_requests/{requestId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidCustomDevRequest(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 7. TECHNICAL INSPECTIONS
    match /technical_inspections/{inspectionId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidTechnicalInspection(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 8. SAFETY INSPECTIONS
    match /safety_inspections/{inspectionId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidSafetyInspection(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 9. SENSITIVE COLLECTIONS: BILLING AND SUBSCRIPTIONS
    match /billing/{billingId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidBillingRecord(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }
    match /subscriptions/{subId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidCompanySubscription(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }
    match /company_subscriptions/{subId} {
      allow read: if belongsToTenant(resource.data);
      allow create, update: if isValidCompanySubscription(request.resource.data);
      allow delete: if belongsToTenant(resource.data);
    }

    // 10. PUBLIC/MARKETING DATA
    match /saas_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /saas_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saas_features/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saas_clients/{clientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saas_reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registered_companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 11. FAULT REPORTS
    match /fault_reports/{reportId} {
      allow read, update, delete: if true;
      allow create: if isValidFaultReport(request.resource.data);
    }
  }
}
