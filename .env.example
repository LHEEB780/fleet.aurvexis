# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# If you are testing locally, you can use "http://localhost:3000".
APP_URL="MY_APP_URL"

# ==============================================================================
# STRIPE PAYMENT GATEWAY CONFIGURATION (بوابة الدفع الإلكتروني واستقبال الأموال)
# ==============================================================================
# 1. STRIPE_SECRET_KEY: Secret API key from your Stripe Dashboard (Developers -> API Keys -> Secret key)
#    Starts with "sk_live_..." for production or "sk_test_..." for testing.
#    All client subscription payments will be automatically credited to your Stripe balance and deposited into your IBAN bank account.
STRIPE_SECRET_KEY=""

# 2. VITE_STRIPE_PUBLISHABLE_KEY: Publishable API key from Stripe Dashboard (Developers -> API Keys -> Publishable key)
#    Starts with "pk_live_..." or "pk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY=""

# 3. STRIPE_WEBHOOK_SECRET: Optional webhook signing secret from Stripe Dashboard (Developers -> Webhooks)
#    Starts with "whsec_..."
STRIPE_WEBHOOK_SECRET=""

# Google Maps Platform Integration Key (Required for live interactive GPS map)
GOOGLE_MAPS_PLATFORM_KEY=""
